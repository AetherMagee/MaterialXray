<resources>
    <string name="ping_method_httping_label">httping (рекомендуется)</string>
    <string name="ping_method_httping_description">Сквозная проверка. Проверяет работоспособность конфигурации и измеряет фактическую задержку.</string>
    <string name="ping_method_tcping_description">Проверка рукопожатия TCP. Показывает только базовую доступность и одностороннюю задержку.</string>

    <string name="subscription_user_agent_automatic_label">Автоматически</string>
    <string name="subscription_user_agent_automatic_description">Представляться как Material Xray и добавлять заголовки с данными устройства.</string>
    <string name="subscription_user_agent_happ_description">Имитировать клиент Happ. Полезно для провайдеров, которые обслуживают только известные клиенты.</string>
    <string name="subscription_user_agent_custom_label">Пользовательский</string>
    <string name="subscription_user_agent_custom_description">Отправлять указанные User-Agent и заголовки без изменений.</string>

    <string name="routing_policy_user_label">Управляется пользователем</string>
    <string name="routing_policy_user_description">Управлять правилами маршрутизации и маршрутизацией приложений вручную</string>
    <string name="routing_policy_subscription_provider_label">Провайдер подписки</string>
    <string name="routing_policy_subscription_provider_description">Применять правила и маршрутизацию приложений от провайдера выбранной подписки</string>

    <string name="root_connection_backend_tun_label">Интерфейс TUN</string>
    <string name="root_connection_backend_tun_description">Создаёт виртуальный интерфейс и направляет трафик приложений к ядру через него.</string>
    <string name="root_connection_backend_tproxy_label">Прозрачный прокси</string>
    <string name="ipv6_session_enabled">Сейчас: IPv6 включён</string>
    <string name="ipv6_session_enabled_until_reconnect">Сейчас: IPv6 включён, но не прошёл проверку через сервер, поэтому следующее подключение будет только по IPv4</string>
    <string name="ipv6_session_no_ipv6_network">Сейчас: только IPv4, в этой сети нет IPv6</string>
    <string name="ipv6_session_check_failed">Сейчас: только IPv4, IPv6 не прошёл проверку в этой сети</string>
    <string name="ipv6_mode_off_label">Выкл.</string>
    <string name="ipv6_mode_off_description">Подключаться только по IPv4.</string>
    <string name="ipv6_mode_auto_label">Авто</string>
    <string name="ipv6_mode_auto_description">Использовать IPv6 в сетях, где быстрая проверка через сервер показывает, что он работает. Пока проверка не пройдена, подключения идут по IPv4.</string>
    <string name="ipv6_mode_on_label">Вкл.</string>
    <string name="ipv6_mode_on_description">Всегда использовать IPv6, если он есть в сети, пробуя его раньше IPv4.</string>
    <string name="other_vpn_mode_auto_routing_label">Автомаршрутизация</string>
    <string name="other_vpn_mode_auto_routing_description">Проксируемые приложения остаются в MXray, кроме собственных сетей другого VPN. Остальные приложения используют другой VPN.</string>
    <string name="other_vpn_mode_tunnel_in_tunnel_label">Туннель в туннеле</string>
    <string name="other_vpn_mode_tunnel_in_tunnel_description">Приложения, которые охватывает другой VPN, используют его для всего, что он маршрутизирует. Трафик самого VPN идёт через MXray, если это приложение проксируется.</string>
    <string name="other_vpn_mode_stand_down_label">Уступать</string>
    <string name="other_vpn_mode_stand_down_description">Пока другой VPN маршрутизирует весь интернет, MXray перестаёт маршрутизировать приложения и оставляет их ему. В остальное время работает как автомаршрутизация.</string>
    <string name="root_connection_backend_tproxy_description">Перехватывает трафик без создания интерфейсов с помощью маршрутов ядра. Экспериментальный и может не работать на старых устройствах.</string>
    <string name="xray_outbound_proxy_label">прокси</string>
    <string name="xray_outbound_proxy_description">Направлять трафик через выбранный прокси-сервер.</string>
    <string name="xray_outbound_direct_label">напрямую</string>
    <string name="xray_outbound_direct_description">Обходить прокси и подключаться напрямую.</string>
    <string name="xray_outbound_block_label">блокировать</string>
    <string name="xray_outbound_block_description">Отбрасывать трафик через исходящее соединение blackhole.</string>

