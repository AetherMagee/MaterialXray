<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MaterialXray" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Shown while MainActivity waits for the home data snapshot; installSplashScreen() swaps to
         postSplashScreenTheme before the first frame is drawn. -->
    <style name="Theme.MaterialXray.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.MaterialXray</item>
    </style>
</resources>
